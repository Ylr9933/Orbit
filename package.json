{
  "name": "agent-infra-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "check": "biome check . && pnpm --filter @agent-infra/web typecheck",
